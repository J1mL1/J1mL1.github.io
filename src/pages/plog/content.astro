---
import Layout from "../../layouts/Layout.astro";
import NeumorphicCard from "../../components/NeumorphicCard.astro";
import "../../styles/main.css";

const pageTitle = "Photo Stream | Jim Li Coming Soon";
const pageDescription = "Jim Li's photo stream is coming soon. Stay tuned for curated photography collections.";
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={["Jim Li photography", "photo stream", "coming soon"]}
    ogType="website"
>
    <div class="layout-stack layout-stack--lg">
        <NeumorphicCard class="text-center">
            <h1 class="page-heading">Photo Stream Coming Soon</h1>
            <p class="page-subheading">
                I'm preparing a curated photo stream. Check back soon for a visual journey through my lens.
            </p>
        </NeumorphicCard>
    </div>
</Layout>

