---
import Layout from "../../layouts/Layout.astro";
import NeumorphicCard from "../../components/NeumorphicCard.astro";
import "../../styles/main.css";

const pageTitle = "Photography | Jim Li Coming Soon";
const pageDescription = "Jim Li's photography portfolio is coming soon. Stay tuned for landscapes, street scenes, and visual stories.";
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={["Jim Li photography", "photography portfolio", "coming soon"]}
    ogType="website"
>
    <div class="layout-stack layout-stack--lg">
        <NeumorphicCard class="text-center">
            <h1 class="page-heading">Photography Coming Soon</h1>
            <p class="page-subheading">
                I'm curating a collection of my favourite shots — landscapes, street scenes, and visual stories from my travels. Stay tuned!
            </p>
        </NeumorphicCard>
    </div>
</Layout>

